<robot name="arm">
    <link name="base_link">
        <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <!-- <box size="1 1 1"/> -->
                <mesh filename="package://arm_description/meshes/link_base.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>
    <link name="link1">
        <visual>
            <geometry>
                <mesh filename="package://arm_description/meshes/link1.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="base_to_link1" type="fixed">
        <origin xyz="0.0 0.0 0.243" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="link1"/>
    </joint>

    <link name="link2">
        <visual>
            <origin xyz="0 0 0.0" rpy="0 -1.585 -0.28"/>
            <geometry>
                <mesh filename="package://arm_description/meshes/link2.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="link1_to_link2" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 5"/>
        <parent link="link1"/>
        <child link="link2"/>
    </joint>

    <link name="link3">
        <visual>
            <origin xyz="-0.009 0.0 0.2" rpy="1.55 0.0 1.25"/>
            <geometry>
                <mesh filename="package://arm_description/meshes/link3.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>
 
    <joint name="link2_to_link3" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="link2"/>
        <child link="link3"/>
    </joint>

    <link name="link4">
        <visual>
            <origin xyz="0.02 0.083 -0.018" rpy="0.0 3.14 -1.8"/>
            <geometry>
                <mesh filename="package://arm_description/meshes/link4.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="link3_to_link4" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="link3"/>
        <child link="link4"/>
    </joint>

    <link name="link5">
        <visual>
            <origin xyz="0.018 0.08 -0.018" rpy="0.0 3.12 1.3"/>
            <geometry>
                <mesh filename="package://arm_description/meshes/link5.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="link4_to_link5" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="link4"/>
        <child link="link5"/>
    </joint>

    <link name="link6">

        <visual>
            <origin xyz="0.018 0.081 -0.06 " rpy="0.0 0.0 -2"/>
            <geometry>
                <mesh filename="package://arm_description/meshes/link6.stl" scale="1 1 1"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.7 0.7 0.7 1.0" />
            </material>
        </visual>
    
    </link>

    <joint name="link5_to_link6" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="link5"/>
        <child link="link6"/>
    </joint>
</robot>